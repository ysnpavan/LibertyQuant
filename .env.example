# ===========================================
# LibertyQuant — Environment Configuration
# ===========================================

# -----------------------------------------
# Anthropic API (Claude agents)
# Get key: https://console.anthropic.com/settings/keys
# -----------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Model routing (defaults shown)
# Deep-reasoning agents: signal validation, risk & compliance
LQ_MODEL_DEEP=claude-opus-4-8
# Fast-loop agents: market regime, strategy selection
LQ_MODEL_FAST=claude-sonnet-4-6
# Effort for fast-loop agents: low | medium | high
LQ_FAST_EFFORT=low

# -----------------------------------------
# Alpaca (paper trading + market data)
# Free paper account: https://app.alpaca.markets/signup
# Keys: https://app.alpaca.markets/paper/dashboard/overview -> "API Keys"
# -----------------------------------------
ALPACA_API_KEY=PK...
ALPACA_SECRET_KEY=...
# true = paper trading endpoint (NEVER set false until you mean it)
ALPACA_PAPER=true

# -----------------------------------------
# Trading configuration
# -----------------------------------------
# local_paper = simulate fills locally | alpaca = route orders to Alpaca paper account
LQ_EXECUTION_MODE=alpaca
# Universe preset: sp100 | nasdaq100 | etfs | all
LQ_UNIVERSE=all
# Max symbols to analyze per cycle (top movers selected from universe)
LQ_MAX_SYMBOLS=10
# Seconds between trading cycles
LQ_CYCLE_SECONDS=60

# -----------------------------------------
# Risk limits (USD)
# -----------------------------------------
LQ_STARTING_CASH=100000
LQ_MAX_POSITION_PCT=0.10
LQ_RISK_PER_TRADE=0.02
LQ_MAX_DAILY_TRADES=20
LQ_DAILY_LOSS_LIMIT=2000
LQ_MAX_OPEN_POSITIONS=8

# -----------------------------------------
# Exit management
# -----------------------------------------
# Trailing stop: % pullback from a position's high-water mark that triggers an exit
LQ_TRAILING_STOP_PCT=0.03
# Close all positions before the end of the trading day
LQ_EOD_FLATTEN=true
LQ_EOD_FLATTEN_MINUTES=10

# -----------------------------------------
# Memory / learning loop
# -----------------------------------------
LQ_MEMORY_ENABLED=true
# Lessons injected into agent context per cycle
LQ_MEMORY_TOP_N=5

# -----------------------------------------
# Notifications (optional) — Telegram (default channel)
# Setup (~3 min):
#   1. Telegram: message @BotFather -> /newbot -> copy the bot token
#   2. Message @userinfobot -> it replies with your chat ID
#   3. Send any message to your new bot once (bots can't message you first)
# -----------------------------------------
LQ_NOTIFICATIONS_ENABLED=false
LQ_NOTIFICATION_CHANNEL=telegram
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_CHAT_ID=123456789

# Alternative channel: WhatsApp via Twilio sandbox
# (set LQ_NOTIFICATION_CHANNEL=whatsapp and fill these instead)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxx
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# WHATSAPP_TO=whatsapp:+91XXXXXXXXXX

# -----------------------------------------
# Data / storage
# -----------------------------------------
LQ_DB_PATH=data/liberty_quant.db
LQ_LOG_LEVEL=INFO
